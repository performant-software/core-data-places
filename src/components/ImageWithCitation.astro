---
import { tinaField } from '@tinacms/astro/tina-field';

interface Props {
  alt?: string;
  citation?: string;
  citationLink?: string;
  classNames?: {
    root?: string;
    image?: string;
    citation?: string;
  };
  src: string;
  item?: any;
}

const { alt, citation, citationLink, classNames, src, item } = Astro.props;
---

{
  citation ? (
    <div class={classNames?.root} data-tina-field={tinaField(item)}>
      <img alt={alt} src={src} class={classNames?.image} />
      {citationLink ? (
        <a href={citationLink} class={classNames?.citation}>
          {citation}
        </a>
      ) : (
        <p class={classNames?.citation}>{citation}</p>
      )}
    </div>
  ) : (
    <img alt={alt} src={src} class={classNames?.image} data-tina-field={tinaField(item)}/>
  )
}
