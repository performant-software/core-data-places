---
import NavDropdown from '@components/NavDropdown';
import NavLink from '@components/NavLink';
import clsx from 'clsx';
import _ from 'underscore';

const { className, items, isTinaPreview } = Astro.props;

---

<div
  class={className}
>
  {!isTinaPreview && _.map(items, (item) => (
    <>
      { item.options && (
        <NavDropdown
          active={item.active}
          content={item.label}
          items={item.options}
          client:only='react'
        />
      )}
      { item.href && (
        <NavLink
          active={item.active}
          content={item.label}
          href={item.href}
        />
      )}
    </>
  ))}
  {
    isTinaPreview && _.map(items, (item) => (
      <a
        class='flex p-y-4 justify-center gap-2 items-center'
        href={item.href || item.options[0].href}
      >
        <div
          class={clsx(
            'flex',
            'font-light',
            { 'border-b border-text-primary': item.active }
          )}
        >
          { item.label }
        </div>
      </a>
    ))
  }
  <slot />
</div>