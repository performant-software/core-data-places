---
import LanguagePicker from "@components/LanguagePicker";
import MobileHeader from "@components/MobileHeader";
import NavBar from "@layouts/NavBar.astro";
import { getCustomNavbar, getDefaultNavbar } from "@utils/nav";
import { getRelativeLocaleUrl, getRelativeLocaleUrlList } from "astro:i18n";
import clsx from "clsx";
import config from '@config';

const locales = getRelativeLocaleUrlList();
const currentLocale = Astro.currentLocale || config?.i18n?.default_locale;

const {
  fullscreen,
  image,
  imageAlt,
  isTinaPreview,
  navbar,
  pages,
  pathname,
  t,
  title,
  transparent
} = Astro.props;

let items;

if (navbar && navbar.items) {
  items = getCustomNavbar(navbar, currentLocale, pathname);
} else {
  items = getDefaultNavbar(pages, currentLocale, pathname, t);
}
---

<div
  class={clsx(
    'flex flex-row justify-center w-full z-10 text-text-primary h-[72px]',
    { 'bg-primary': !transparent }
  )}
>
  <div
    class={clsx(
      "hidden xl:flex flex-row justify-between items-center px-12 py-3 w-full",
      { "3xl:max-w-(--breakpoint-3xl)": !fullscreen },
    )}
  >
    <a
      class="flex flex-row items-center gap-6"
      href={getRelativeLocaleUrl(currentLocale)}
    >
      {image && <img alt={imageAlt} class="h-12" src={image} height={48} />}
      {title && <h1 class="text-2xl font-medium">{title}</h1>}
    </a>
    <NavBar
      className="flex flex-row gap-x-12 align-baseline justify-around"
      items={items}
      isTinaPreview={isTinaPreview}
    >
      {
        !isTinaPreview && (
          <LanguagePicker
            locales={locales}
            currentLocale={currentLocale}
            currentUrl={pathname}
            client:only="react"
          />
        )
      }
    </NavBar>
  </div>

  {
    !isTinaPreview && (
      <MobileHeader
        image={image}
        items={items}
        title={title}
        transparent={transparent}
        client:load
      >
        <LanguagePicker
          locales={locales}
          currentLocale={currentLocale}
          currentUrl={pathname}
          client:load
        />
      </MobileHeader>
    )
  }

</div>

