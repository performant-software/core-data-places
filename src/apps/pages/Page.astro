---
import PageBody from '@components/PageBody.astro';
import { setCacheControl } from '@utils/url';
import { tinaField } from '@tinacms/astro/tina-field';

const { page, isTinaPreview } = Astro.props;

setCacheControl(Astro.response.headers);

---
<div data-tina-field={tinaField(page)}>
  <PageBody
    sections={page?.sections}
    transparent={page?.transparent}
    home={page?.home_page}
    isTinaPreview={isTinaPreview}
  />
</div>