---
import PathViewer from '@apps/paths/PathViewer';
import { fetchPathResponse } from '@backend/tina';
import config from '@config';

const { slug } = Astro.props;
const pathResponse = await fetchPathResponse(slug);

const pageTitle = pathResponse?.data?.path.title;

let overlayLayer = null;

if (pathResponse.data?.path.overlay_layer) {
  const match = config.layers.find(l =>
    l.overlay &&
    l.url === pathResponse.data?.path.overlay_layer
  );

  if (match) {
    overlayLayer = match;
  }
}

---

<PathViewer
  {...pathResponse}
  overlayLayer={overlayLayer}
  client:only='react'
/>

<script is:inline define:vars={{ pageTitle }}>
  if (pageTitle) {
    document.title = pageTitle;
  }
</script>