---
import PathViewer from '@apps/paths/PathViewer';
import { fetchBranding, fetchPathResponse } from '@backend/tina';
import PageStoreProvider from '@components/PageStoreProvider';
import config from '@config';

const branding = await fetchBranding();

const { slug, publishedOnly } = Astro.props;
const pathResponse = await fetchPathResponse(slug);

if (publishedOnly && !pathResponse.data?.path?.published) {
  return new Response(null, { status: 404 });
}

let overlayLayer = null;

if (pathResponse.data?.path.overlay_layer) {
  const match = config.layers.find(l =>
    l.overlay &&
    l.url === pathResponse.data?.path.overlay_layer
  );

  if (match) {
    overlayLayer = match;
  }
}

---

<PathViewer
  {...pathResponse}
  colors={{
    geometry: branding?.map?.geometry_color,
    selected: branding?.map?.selected_color,
  }}
  overlayLayer={overlayLayer}
  client:only='react'
/>

<PageStoreProvider
  title={pathResponse?.data?.path.title}
  client:load
/>